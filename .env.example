# Environment Configuration Template for Sumbar Flood Hazard Pipeline
# Copy this file to '.env' and adjust paths if your virtual environment is located elsewhere.
# PROJ_DATA and PROJ_LIB are automatically discovered by scripts/_env.py,
# but can be explicitly specified here for external GDAL/PROJ binaries.

PROJ_DATA=./.venv/Lib/site-packages/rasterio/proj_data
PROJ_LIB=./.venv/Lib/site-packages/rasterio/proj_data
GDAL_DATA=./.venv/Lib/site-packages/rasterio/gdal_data
SFINCS_PATH=./bin/sfincs.exe
